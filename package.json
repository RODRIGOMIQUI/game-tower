{
  "name": "gametower",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data": "node tools/csv-para-json.mjs",
    "sim": "vitest run src/sim/cenario.test.ts src/sim/carreira.test.ts --silent=false",
    "sim:partida": "vitest run src/sim/partida.test.ts --silent=false",
    "bench": "vitest run src/sim/bench.test.ts --silent=false",
    "bench:perfil": "vite build --config tools/bench/vite.config.ts && node --cpu-prof --cpu-prof-dir=tools/bench/dist tools/bench/dist/bench.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "pixi.js": "^8.23.0"
  }
}
